<?xml version="1.0"?>
<!-- Wrist D405 optical frame from Cell C FOV YAML (tool mm → m).
     Optical: X=right, Y=down, Z=look (ROS). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="d405_optical_frame" params="parent:=gripper_centor_link">
    <link name="wrist_cam_d405_optical_frame">
      <!-- Inertia required so Gazebo keeps this link (no fixed-joint lump into link6). -->
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.005 0.005 0.01"/></geometry>
        <material name="optical_axis"><color rgba="0.1 0.8 0.7 0.4"/></material>
      </visual>
    </link>
    <joint name="wrist_cam_d405_optical_fixed" type="fixed">
      <parent link="${parent}"/>
      <child link="wrist_cam_d405_optical_frame"/>
      <origin xyz="0.000045 0.095734 0.123294" rpy="0.94831327 -0.00065494 0.0"/>
    </joint>
  </xacro:macro>
</robot>
