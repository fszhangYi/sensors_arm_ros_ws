<?xml version="1.0"?>
<sdf version="1.6">
  <model name="fov_legend_board">
    <static>true</static>
    <link name="link">
      <visual name="board">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box><size>0.72 0.42 0.01</size></box>
        </geometry>
        <material>
          <script>
            <uri>model://fov_legend_board/materials/scripts</uri>
            <uri>model://fov_legend_board/materials/textures</uri>
            <name>FovLegend/Diffuse</name>
          </script>
        </material>
      </visual>
      <!-- Color chips even if texture fails to load -->
      <visual name="chip_root">
        <pose>-0.28 0.12 0.008 0 0 0</pose>
        <geometry><box><size>0.04 0.04 0.01</size></box></geometry>
        <material><ambient>0.9 0.15 0.1 1</ambient><diffuse>0.95 0.2 0.1 1</diffuse></material>
      </visual>
      <visual name="chip_tip">
        <pose>-0.28 0.04 0.008 0 0 0</pose>
        <geometry><sphere><radius>0.02</radius></sphere></geometry>
        <material><ambient>0.1 0.7 0.3 1</ambient><diffuse>0.15 0.85 0.35 1</diffuse></material>
      </visual>
      <visual name="chip_hook_c">
        <pose>-0.28 -0.04 0.008 0 0 0</pose>
        <geometry><sphere><radius>0.02</radius></sphere></geometry>
        <material><ambient>0.15 0.3 0.85 1</ambient><diffuse>0.2 0.4 0.95 1</diffuse></material>
      </visual>
      <visual name="chip_hook_o">
        <pose>-0.28 -0.12 0.008 0 0 0</pose>
        <geometry><sphere><radius>0.02</radius></sphere></geometry>
        <material><ambient>0.85 0.75 0.1 1</ambient><diffuse>0.95 0.85 0.15 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
